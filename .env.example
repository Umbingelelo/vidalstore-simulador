# Copiar como .env en la carpeta del simulador y descomentar lo que se quiera cambiar.
# Gana la línea de comandos, después estas variables y al final el valor por defecto.
# node reproducir.mjs --ayuda muestra todas las opciones.

# Dónde está Kafka. En gestion (AWS): 10.0.21.11:9092,10.0.22.12:9092,10.0.21.13:9092
# SIM_BROKERS=localhost:9092,localhost:9094,localhost:9096

# 60 = la hora en un minuto; 600 = en unos 6 segundos; 0 = todo de una vez
# SIM_VELOCIDAD=60

# Tramo de la noche, en minutos desde las 21:00. La ráfaga de errores: 30 a 35
# SIM_DESDE=0
# SIM_HASTA=60

# Cuántas veces se publica el tramo, una tras otra
# SIM_REPETIR=1

# actividad o compras; vacío = los dos
# SIM_SOLO=

# si o no: omitir los eventos inválidos o los duplicados puestos a propósito
# SIM_SIN_INVALIDOS=no
# SIM_SIN_DUPLICADOS=no

# Topics de destino, para probar en topics aparte sin ensuciar los de la pauta
# SIM_TOPIC_ACTIVIDAD=vidalstore.actividad
# SIM_TOPIC_COMPRAS=vidalstore.compras

# Carpeta del dataset
# SIM_DATASET=dataset

# Cada cuántos mensajes se muestra el avance
# SIM_CADA=500

# Red y reintentos
# SIM_TIMEOUT_CONEXION=5000
# SIM_REINTENTOS=10
# SIM_ESPERA_REINTENTO=1000
# SIM_REINTENTOS_LOTE=3
# SIM_ESPERA_LOTE=10

# client.id del productor
# SIM_CLIENT_ID=vidalstore-simulador

# si = valida el dataset y las opciones sin conectarse a Kafka
# SIM_SECO=no
